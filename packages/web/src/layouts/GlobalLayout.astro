---
import "@/styles/global.css";
import "@fontsource/long-cang";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="viewport"
      content="width=device-width, viewport-fit=cover, initial-scale=1.0"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title || "诗词集"}</title>
  </head>
  <body class="text-text-primary dark:text-text-primary-dark bg-bg dark:bg-bg-dark font-pingfang">
    <slot />
  </body>
</html>
